{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dacn/d0/artifact.schema.json",
  "title": "artifact d0-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "sha256",
    "size_bytes",
    "media_type",
    "relative_path"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ART-[A-Za-z0-9_-]{8,100}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
