{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Collect file context",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["${workspaceFolder}/context_collector.py", "--file", "${input:samplePath}", "--output", "${workspaceFolder}/collections", "--progress"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Collect process context",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["${workspaceFolder}/context_collector.py", "--pid", "${input:pid}", "--output", "${workspaceFolder}/collections", "--progress"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id":"samplePath","type":"promptString","description":"Absolute file path without surrounding quotes"},
    {"id":"pid","type":"promptString","description":"PID to inspect (metadata only)"}
  ]
}
